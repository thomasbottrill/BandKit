{
  "manifest_version": 3,
  "name": "BandKit",
  "version": "0.7.5",
  "minimum_chrome_version": "116",
  "description": "A floating Bandcamp toolkit with persistent playlists, seamless playback, DJ tools, and durable cart backups.",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BandKit",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle BandKit"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://bandcamp.com/*"
      ],
      "js": [
        "feed-redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ],
      "js": [
        "page-media-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ],
      "js": [
        "cart-autosave.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "hub.css",
        "modern-release.css"
      ],
      "matches": [
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*"
      ]
    }
  ]
}
